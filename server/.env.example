# Environment Configuration for IMovies Server
PORT=5000
NODE_ENV=development

# Database Configuration
# Local MongoDB example: mongodb://localhost:27017/imovies
# MongoDB Atlas example: mongodb+srv://<username>:<password>@cluster.mongodb.net/imovies?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/imovies

# JWT Secret & Cookie Configuration
JWT_SECRET=super_secret_jwt_key_replace_with_random_64_chars_in_prod
JWT_EXPIRES_IN=7d
COOKIE_NAME=imovies_token

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
